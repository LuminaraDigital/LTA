{
  "name": "lta",
  "version": "0.1.0",
  "private": true,
  "description": "Luminara Trading Agent control plane for governed crypto wallet automation.",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/core/migrate.ts",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.0.7",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
