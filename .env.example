NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LTA_ENVIRONMENT=development
LTA_ORGANIZATION_NAME=Luminara Digital
LTA_DEPLOYMENT_STAGE=local
LTA_POLICY_NAME=lta-enterprise-alpha
LTA_POLICY_VERSION=2026-04-enterprise-alpha
LTA_ALLOWED_VENUES=ton-stonfi,binance,bybit,okx,hyperliquid
